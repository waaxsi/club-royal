# Développement local : copier en .env. Aucun vrai secret dans ce fichier modèle.
PORT=3000
NODE_ENV=development
DATA_FILE=./data/club-royal.sqlite
PUBLIC_BASE_URL=

# Propriétaire : fournir les DEUX valeurs avant la première publication.
# Générer le hash avec npm run admin:hash. Ne jamais mettre le mot de passe ici.
ADMIN_USER=waaxsi
ADMIN_PASSWORD_HASH=

# Hébergement sans disque durable : base libSQL/Turso externe (secrets serveur).
# URL https://… ou libsql://… ou turso://… ; ne pas inclure de token dans l’URL.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 1 UNIQUEMENT si DATA_FILE est réellement sur un disque durable configuré.
# Ne pas mettre 1 pour contourner le contrôle sur Render gratuit !
PERSISTENT_STORAGE=0

# 0 en local. En production, vérifier le nombre de proxies de confiance.
# Render : 1 seulement après vérification de son proxy, pas de confiance aveugle.
TRUST_PROXY_HOPS=0
